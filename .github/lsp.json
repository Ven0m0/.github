{
  "lspServers": {
    "bash": {
      "command": "bash-language-server",
      "args": ["start"],
      "fileExtensions": {
        ".sh": "shellscript",
        ".bash": "shellscript",
        ".zsh": "shellscript",
        ".ksh": "shellscript"
      }
    },
    "python": {
      "command": "basedpyright-langserver",
      "args": ["--stdio"],
      "fileExtensions": {
        ".py": "python",
        ".pyi": "python"
      }
    },
    "typescript": {
      "command": "vtsls",
      "args": ["--stdio"],
      "fileExtensions": {
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".js": "javascript",
        ".jsx": "javascriptreact",
        ".mts": "typescript",
        ".cts": "typescript",
        ".mjs": "javascript",
        ".cjs": "javascript"
      }
    },
    "rust": {
      "command": "rust-analyzer",
      "args": [],
      "fileExtensions": {
        ".rs": "rust"
      }
    },
    "json": {
      "command": "vscode-json-language-server",
      "args": ["--stdio"],
      "fileExtensions": {
        ".json": "json",
        ".jsonc": "jsonc"
      }
    },
    "yaml": {
      "command": "yaml-language-server",
      "args": ["--stdio"],
      "fileExtensions": {
        ".yaml": "yaml",
        ".yml": "yaml"
      }
    },
    "html": {
      "command": "vscode-html-language-server",
      "args": ["--stdio"],
      "fileExtensions": {
        ".html": "html",
        ".htm": "html"
      }
    },
    "css": {
      "command": "vscode-css-language-server",
      "args": ["--stdio"],
      "fileExtensions": {
        ".css": "css",
        ".scss": "scss",
        ".less": "less"
      }
    },
    "markdown": {
      "command": "marksman",
      "args": ["server"],
      "fileExtensions": {
        ".md": "markdown"
      }
    },
    "dockerfile": {
      "command": "docker-langserver",
      "args": ["--stdio"],
      "fileExtensions": {
        "Dockerfile": "dockerfile",
        ".dockerfile": "dockerfile"
      }
    },
    "go": {
      "command": "gopls",
      "args": ["serve"],
      "fileExtensions": {
        ".go": "go"
      }
    },
    "cpp": {
      "command": "clangd",
      "args": ["--background-index"],
      "fileExtensions": {
        ".c": "c",
        ".h": "c",
        ".cpp": "cpp",
        ".hpp": "cpp",
        ".cc": "cpp",
        ".cxx": "cpp",
        ".hxx": "cpp",
        ".m": "objective-c",
        ".mm": "objective-cpp"
      }
    },
    "java": {
      "command": "jdtls",
      "args": [],
      "fileExtensions": {
        ".java": "java"
      }
    },
    "kotlin": {
      "command": "kotlin-language-server",
      "args": [],
      "fileExtensions": {
        ".kt": "kotlin",
        ".kts": "kotlin"
      }
    },
    "swift": {
      "command": "sourcekit-lsp",
      "args": [],
      "fileExtensions": {
        ".swift": "swift"
      }
    },
    "csharp": {
      "command": "OmniSharp",
      "args": ["-lsp"],
      "fileExtensions": {
        ".cs": "csharp"
      }
    },
    "ruby": {
      "command": "solargraph",
      "args": ["stdio"],
      "fileExtensions": {
        ".rb": "ruby",
        ".rake": "ruby",
        ".gemspec": "ruby"
      }
    },
    "php": {
      "command": "intelephense",
      "args": ["--stdio"],
      "fileExtensions": {
        ".php": "php"
      }
    },
    "elixir": {
      "command": "elixir-ls",
      "args": [],
      "fileExtensions": {
        ".ex": "elixir",
        ".exs": "elixir"
      }
    },
    "scala": {
      "command": "metals",
      "args": [],
      "fileExtensions": {
        ".scala": "scala",
        ".sc": "scala"
      }
    },
    "r": {
      "command": "R",
      "args": ["--slave", "-e", "languageserver::run()"],
      "fileExtensions": {
        ".r": "r",
        ".R": "r",
        ".Rmd": "rmarkdown"
      }
    },
    "dart": {
      "command": "dart",
      "args": ["language-server", "--protocol=lsp"],
      "fileExtensions": {
        ".dart": "dart"
      }
    },
    "fish": {
      "command": "fish-lsp",
      "args": ["start"],
      "fileExtensions": {
        ".fish": "fish"
      }
    },
    "biome": {
      "command": "biome",
      "args": ["lsp-proxy"],
      "fileExtensions": {
        ".js": "javascript",
        ".jsx": "javascriptreact",
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".json": "json",
        ".jsonc": "jsonc"
      }
    },
    "toml": {
      "command": "tombi",
      "args": ["lsp"],
      "fileExtensions": {
        ".toml": "toml"
      }
    },
    "typos": {
      "command": "typos-lsp",
      "args": [],
      "fileExtensions": {
        "*": "all"
      }
    },
    "markdown-oxide": {
      "command": "markdown-oxide",
      "args": [],
      "fileExtensions": {
        ".md": "markdown"
      }
    }
  }
}
