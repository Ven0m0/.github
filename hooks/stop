#!/usr/bin/env bash
# Stop hook: final checks before Claude stops responding
# Inspired by github.com/johnzfitch/claude-warden

set -o pipefail

INPUT=$(cat)

# Source helper script
source "$(dirname "$0")/helper.sh"

STOP_REASON=$(jq_extract '.stop_reason' '')
SESSION_ID=$(jq_extract '.session_id' '')

LOG_FILE="${HOME}/.claude/sessions.log"
mkdir -p "$(dirname "$LOG_FILE")"
printf '[%s] stop reason=%s session=%s\n' \
  "$(date -Iseconds 2>/dev/null || date +%Y-%m-%dT%H:%M:%S)" \
  "$STOP_REASON" \
  "$SESSION_ID" >>"$LOG_FILE"

# Continue normally
cat <<'EOF'
{
  "continue": true
}
EOF

exit 0
