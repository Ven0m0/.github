#!/usr/bin/env bash
# Stop hook: final checks before Claude stops responding
# Inspired by github.com/johnzfitch/claude-warden

set -euo pipefail

INPUT="$(cat)"

# Source helper script
source "$(dirname "$0")/helper.sh"

STOP_REASON="$(jq_extract '.reason // .stop_reason // empty' '')"
SESSION_PATH="$(jq_extract '.cwd // empty' '')"

LOG_FILE="${HOME}/.claude/sessions.log"
mkdir -p "$(dirname "${LOG_FILE}")"
LOG_TIMESTAMP="$(date -Iseconds 2>/dev/null || date +%Y-%m-%dT%H:%M:%S)"
printf '[%s] stop reason=%s session=%s\n' \
  "${LOG_TIMESTAMP}" \
  "${STOP_REASON}" \
  "${SESSION_PATH}" >>"${LOG_FILE}"

# Continue normally
cat <<'EOF'
{
  "continue": true
}
EOF

exit 0
