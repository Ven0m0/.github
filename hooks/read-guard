#!/usr/bin/env bash
# Read-guard hook: enforce file size limits before reading
# Runs as a PreToolUse hook for the Read tool
# Inspired by github.com/johnzfitch/claude-warden

set -euo pipefail

INPUT="$(cat)"

# Source helper script
source "$(dirname "$0")/helper.sh"

FILE_PATH="$(tool_args_extract '.path // .file_path // empty' '' '.tool_input.file_path')"
LIMIT="$(tool_args_extract '.limit // 0' '0' '.tool_input.limit')"

[[ -z "${FILE_PATH}" ]] && exit 0

# Skip non-existent or non-regular files
[[ ! -f "${FILE_PATH}" ]] && exit 0

# Get file size in bytes
FILE_BYTES="$(wc -c <"${FILE_PATH}" 2>/dev/null || echo 0)"
FILE_LINES="$(wc -l <"${FILE_PATH}" 2>/dev/null || echo 0)"

MAX_BYTES=$((2 * 1024 * 1024)) # 2MB hard limit

# Block reads of files over 2MB without offset/limit
if ((FILE_BYTES > MAX_BYTES)) && ((LIMIT == 0)); then
  deny_tool_use "File too large to read in full (${FILE_BYTES}B, max 2MB). Use Grep to find relevant sections, then Read with offset and limit parameters."
fi

# Binary file detection: skip reads of binary files
if file "${FILE_PATH}" 2>/dev/null | grep -q 'binary\|executable\|data'; then
  deny_tool_use "Blocked: ${FILE_PATH} appears to be a binary file. Use wc -c or file command to inspect it instead."
fi

exit 0
