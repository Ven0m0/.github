{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "bash hooks/session-start",
        "timeoutSec": 10
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "bash hooks/session-end",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "bash hooks/pre-tool-use",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "bash hooks/read-guard",
"timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "bash hooks/post-tool-use",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "bash hooks/lint.sh",
        "timeoutSec": 30
      }
    ]
  }
}
