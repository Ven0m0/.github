#!/usr/bin/env bash
# Session-start hook: initialize state, inject context guidance
# Inspired by github.com/johnzfitch/claude-warden

set -o pipefail

INPUT=$(cat)

SESSION_ID=$(printf '%s' "$INPUT" | jq -r '.session_id // ""' 2>/dev/null)

# Initialize state directory
STATE_DIR="${HOME}/.claude/.statusline"
mkdir -p "$STATE_DIR"

# Record session start time
date +%s >"$STATE_DIR/.session_start"

# Log session start
LOG_FILE="${HOME}/.claude/sessions.log"
mkdir -p "$(dirname "$LOG_FILE")"
printf '[%s] session_start id=%s\n' "$(date -Iseconds 2>/dev/null || date +%Y-%m-%dT%H:%M:%S)" "$SESSION_ID" >>"$LOG_FILE"

# Rotate log if over 500 lines
LINE_COUNT=$(wc -l <"$LOG_FILE" 2>/dev/null || echo 0)
if ((LINE_COUNT > 500)); then
  TMP=$(mktemp)
  tail -n 200 "$LOG_FILE" >"$TMP" && mv "$TMP" "$LOG_FILE"
fi

# Inject session-level guidance
cat <<'EOF'
{
  "hookSpecificOutput": {
    "hookEventName": "SessionStart",
    "additionalContext": "File reading strategy: use Grep to locate line numbers first, then Read with offset+limit for targeted sections. Tier 1 (<200 lines): full read OK. Tier 2 (200-500 lines): use offset/limit. Tier 3 (500-1000 lines): grep then targeted read. Tier 4 (1000+ lines): Grep only or delegate to Explore. Always prefer rg over grep. Use fd over find. Batch independent tool calls in a single response to reduce turns."
  }
}
EOF

exit 0
