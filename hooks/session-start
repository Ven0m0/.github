#!/usr/bin/env bash
# Session-start hook: initialize state, inject context guidance
# Inspired by github.com/johnzfitch/claude-warden

set -euo pipefail

INPUT="$(cat)"

# Source helper script
source "$(dirname "$0")/helper.sh"

SOURCE="$(jq_extract '.source // empty' '')"
TIMESTAMP_MS="$(jq_extract '.timestamp // empty' '')"

# Initialize state directory
STATE_DIR="${HOME}/.claude/.statusline"
mkdir -p "${STATE_DIR}"

# Record session start time
if [[ -n "${TIMESTAMP_MS}" && "${TIMESTAMP_MS}" =~ ^[0-9]+$ ]]; then
  printf '%s\n' "$((TIMESTAMP_MS / 1000))" >"${STATE_DIR}/.session_start"
else
  date +%s >"${STATE_DIR}/.session_start"
fi

# Log session start
LOG_FILE="${HOME}/.claude/sessions.log"
mkdir -p "$(dirname "${LOG_FILE}")"
LOG_TIMESTAMP="$(date -Iseconds 2>/dev/null || date +%Y-%m-%dT%H:%M:%S)"
printf '[%s] session_start source=%s\n' "${LOG_TIMESTAMP}" "${SOURCE:-unknown}" >>"${LOG_FILE}"

# Rotate log if over 500 lines
LINE_COUNT="$(wc -l <"${LOG_FILE}" 2>/dev/null || echo 0)"
if ((LINE_COUNT > 500)); then
  TMP="$(mktemp)"
  tail -n 200 "${LOG_FILE}" >"${TMP}" && mv "${TMP}" "${LOG_FILE}"
fi

exit 0
