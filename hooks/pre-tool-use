#!/usr/bin/env bash
# Pre-tool-use hook: safety checks, token dump prevention, command validation
# Inspired by github.com/johnzfitch/claude-warden

set -o pipefail

INPUT=$(cat)

# Source helper script
source "$(dirname "$0")/helper.sh"

# Helpers
_allow() { exit 0; }
_deny() {
  printf '{"decision":"block","reason":"%s"}\n' "${1//\"/\'}"
  exit 0
}
_suppress_ok() {
  printf '{"decision":"approve","suppressOutput":true}\n'
  exit 0
}

TOOL_NAME=$(jq_extract '.tool_name // .toolName' '')
COMMAND=$(jq_extract '.tool_input.command' '')

# === SIZE LIMIT CHECKS ===
case "$TOOL_NAME" in
  Write)
    CONTENT=$(jq_extract '.tool_input.content' '')
    FILE_PATH=$(jq_extract '.tool_input.file_path' '')
    if ((${#CONTENT} > 102400)); then
      _deny "Write blocked: content exceeds 100KB (${#CONTENT}B) for $FILE_PATH. Break into smaller writes."
    fi
    _suppress_ok
    ;;
  Edit | StrReplace)
    NEW=$(jq_extract '.tool_input.new_string' '')
    FILE_PATH=$(jq_extract '.tool_input.file_path' '')
    if ((${#NEW} > 51200)); then
      _deny "Edit blocked: new_string exceeds 50KB (${#NEW}B) for $FILE_PATH. Use smaller targeted edits."
    fi
    _suppress_ok
    ;;
  Glob)
    PATTERN=$(jq_extract '.tool_input.pattern' '')
    GLOB_PATH=$(jq_extract '.tool_input.path' '')
    HOME_RE='^(/home/[^/]+|~|/Users/[^/]+|/root)/?$'
    if [[ "$PATTERN" =~ \*\* ]]; then
      if [[ "$GLOB_PATH" =~ $HOME_RE ]] || [[ -z "$GLOB_PATH" && "$PWD" =~ $HOME_RE ]]; then
        _deny "Glob blocked: recursive glob in home directory. Narrow the path or use fd."
      fi
    fi
    _suppress_ok
    ;;
  Bash) ;; # fall through to bash checks
  *) _allow ;;
esac

[[ -z "$COMMAND" ]] && _allow

NORM=$(echo "$COMMAND" | tr -s '[:space:]' ' ')

# === DESTRUCTIVE COMMAND BLOCKS ===
case "$NORM" in
  *"rm -rf /"* | *"rm -fr /"* | *"rm -rf ~"* | *"rm -fr ~"* | \
    *"rm -rf ."* | *"rm -fr ."* | *"rm -rf *"* | *"rm -fr *"* | \
    *"rm --recursive --force"* | *"rm --force --recursive"* | \
    *"mkfs"* | *"dd if="* | *"dd of=/dev/"* | \
    *"> /dev/sd"* | *"> /dev/nvme"* | \
    *"chmod -R 777 /"* | *"chown -R"*)
    _deny "Blocked: destructive command detected. Verify intent and use a safer form."
    ;;
esac

# Fork bomb detection
if [[ "$NORM" =~ :\(\)[[:space:]]*\{[[:space:]]*:\|:[[:space:]]*\&[[:space:]]*\} ]]; then
  _deny "Blocked: fork bomb pattern detected."
fi

# RCE pipe detection (curl/wget piped to interpreter)
case "$NORM" in
  *"curl"*"|"*"bash"* | *"curl"*"|"*"sh"* | *"curl"*"|"*"python"* | \
    *"wget"*"|"*"bash"* | *"wget"*"|"*"sh"* | *"wget"*"|"*"python"* | \
    *"bash <(curl"* | *"sh <(curl"* | *"bash <(wget"* | *"sh <(wget"*)
    _deny "Blocked: remote code execution pattern (curl/wget piped to interpreter)."
    ;;
esac

# === GIT SAFETY ===
# Unbounded git log dumps entire history
if [[ "$NORM" =~ ^[[:space:]]*git[[:space:]]+log ]] && [[ ! "$NORM" =~ (-n[[:space:]]*[0-9]+|-[0-9]+|--oneline|--stat) ]]; then
  _deny "Blocked: unbounded git log. Use git log -n 20 --oneline or add a limit."
fi

# git commit without quiet flag produces verbose output
if [[ "$NORM" =~ git[[:space:]]+commit ]] && [[ ! "$NORM" =~ (-q|--quiet) ]]; then
  _deny "Use git commit -q to suppress verbose output."
fi

# === FFMPEG VERBOSITY ===
if [[ "$NORM" =~ ffmpeg ]] && [[ ! "$NORM" =~ -nostats ]]; then
  _deny "ffmpeg commands must include -nostats -loglevel error to suppress verbose output."
fi

# === ALLOW METADATA COMMANDS ===
[[ "$NORM" =~ ^[[:space:]]*(wc|stat|file|du|md5sum|sha256sum)[[:space:]] ]] && _allow

# All other Bash commands are allowed
_allow
