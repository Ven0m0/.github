#!/usr/bin/env bash
set -euo pipefail

if ! command -v mise >/dev/null 2>&1; then
  printf '%s\n' 'mise is required to run this repository pre-commit hook.' >&2
  printf '%s\n' 'Install mise, then run: mise run install-hooks' >&2
  exit 1
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "${repo_root}"

exec mise run check
