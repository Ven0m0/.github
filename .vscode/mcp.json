{
  "mcpServers": {
    "github-mcp-server": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/x/all/insiders",
      "tools": ["*"]
    },
    "sequential-thinking": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "tools": ["*"]
    },
    "exa": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_search_advanced_exa,get_code_context_exa,crawling_exa",
      "tools": ["*"],
      "headers": { "EXA_API_KEY": "${EXA_API_KEY}" }
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "tools": ["*"],
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "ref-tools": {
      "type": "http",
      "url": "https://api.ref.tools/mcp",
      "tools": ["*"]
    },
    "grep-app": {
      "type": "http",
      "url": "https://mcp.grep.app",
      "tools": ["*"]
    },
    "serena": {
      "type": "local",
      "tools": ["*"],
      "command": "uvx",
      "args": ["--from", "git+https://github.com/oraios/serena", "serena", "start-mcp-server", "--project-from-cwd"]
    },
    "gitmcp-docs": {
      "type": "http",
      "url": "https://gitmcp.io/Ven0m0/.github",
      "tools": ["*"]
    },
    "octocode": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "octocode-mcp@latest"],
      "tools": ["*"],
      "env": { "GITHUB_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
  }
}
