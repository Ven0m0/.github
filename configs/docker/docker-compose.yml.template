services:
  app:
    build:
      context: .
      dockerfile: Dockerfile
    image: ghcr.io/yourorg/my-project:latest
    restart: unless-stopped
    ports:
      - "3000:3000"
    environment:
      - NODE_ENV=production
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3000/health"]
      interval: 30s
      timeout: 10s
      retries: 3
